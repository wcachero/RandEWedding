{
  "name": "myika-letter",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4201",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "wrangler dev --port 8787 --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply randewedding-rsvp --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply randewedding-rsvp --remote",
    "dev": "npm run db:migrate:local && npx --yes concurrently -k -n api,web -c cyan,magenta \"npm run api\" \"npm start\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.2",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.157.0"
  }
}
